# Image tag: latest, a version (0.1.0), a minor line (0.1) or a release candidate (0.1.0-rc.1).
COOKIT_VERSION=latest

# Public URL of the app, e.g. https://cookit.example.com (cookies, CSRF checks, links).
ORIGIN=
# Session signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: email pre-filled on the first-admin setup page (the link is in the app logs).
ADMIN_EMAIL=
# true behind a reverse proxy (default); false when the port is published directly.
TRUST_PROXY=true

# Web Push keys for the timer notifications (empty: notifications are off). Generate them once
# and keep them: new keys make every device turn notifications on again.
#   docker run --rm --entrypoint node shiyamii/cookit:latest -e "console.log(require('web-push').generateVAPIDKeys())"
#   or, in the running container: node dist/cli.js push:vapid-keys
#   or: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto:you@example.com or an https URL (default: ADMIN_EMAIL, else ORIGIN).
VAPID_SUBJECT=

# Host port, only used with docker-compose.ports.yml (not behind a proxy).
COOKIT_PORT=3000

# Database. Use a URL-safe password (it is embedded in DATABASE_URL), e.g.: openssl rand -hex 24
POSTGRES_USER=cookit
POSTGRES_PASSWORD=
POSTGRES_DB=cookit
