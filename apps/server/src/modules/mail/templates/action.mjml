<!--
  An email with one action (a link to open). `%%name%%` is a theme color, filled in when the
  template is compiled (`bun run emails`); `{{name}}` is filled in at send time, HTML-escaped.
-->
<mjml lang="{{lang}}">
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preview }}</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="16px" line-height="1.6" color="%%foreground%%" padding="0 0 16px 0" />
      <mj-button
        background-color="%%primary%%"
        color="%%primary-foreground%%"
        border-radius="%%radius%%"
        font-size="16px"
        font-weight="600"
        inner-padding="14px 28px"
        padding="8px 0 24px 0"
        align="left"
      />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="%%muted%%" width="560px">
    <mj-section padding="32px 16px 16px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" padding="0">
          <span
            style="
              display: inline-block;
              width: 14px;
              height: 14px;
              border-radius: 7px;
              background: %%primary%%;
              vertical-align: middle;
            "
          ></span>
          <span style="vertical-align: middle">CookIt</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper
      background-color="%%card%%"
      border="1px solid %%border%%"
      border-radius="%%radius%%"
      padding="32px 28px"
    >
      <mj-section padding="0">
        <mj-column>
          <mj-text font-size="22px" font-weight="700" line-height="1.3">{{ heading }}</mj-text>
          <mj-text>{{ intro }}</mj-text>
          <mj-button href="{{url}}">{{ button }}</mj-button>
          <mj-text font-size="14px" color="%%muted-foreground%%">{{ note }}</mj-text>
          <mj-text font-size="13px" color="%%muted-foreground%%" padding="0">
            {{ linkHint }}<br />
            <a href="{{url}}" style="color: %%foreground%%; word-break: break-all">{{ url }}</a>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="16px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="%%muted-foreground%%">{{ footer }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
