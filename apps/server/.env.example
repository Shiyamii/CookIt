PORT=3000
DATABASE_URL=postgres://cookit:cookit@localhost:5432/cookit
# In development the browser talks to Vite (port 5173), which proxies /api to the server.
ORIGIN=http://localhost:5173
# Any 32+ character string in development; `openssl rand -base64 32` in production.
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
# Optional: pre-filled email on the first-admin setup page.
ADMIN_EMAIL=
