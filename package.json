{
  "name": "cookit",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@cookit/server' --filter '@cookit/web' dev",
    "build": "bun run --filter '@cookit/web' build && bun run --filter '@cookit/server' build",
    "start": "bun run --filter '@cookit/server' start",
    "build:demo": "bun run --filter '@cookit/web' build:demo",
    "dev:demo": "bun run --filter '@cookit/web' dev:demo",
    "test:demo": "DEMO_BASE=/CookIt/ bun run build:demo && playwright test -c playwright.demo.config.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "parse": "bun packages/shared/scripts/parse-recipe.ts",
    "emails": "bun apps/server/scripts/emails.ts && prettier --write apps/server/src/modules/mail/templates.generated.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p e2e",
    "db:generate": "bun run --filter '@cookit/server' db:generate",
    "db:migrate": "bun run --filter '@cookit/server' db:migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  }
}
